# ═══════════════════════════════════════════════════════════════════════════
#  Ultimate Music Bot — configuration
#  Copy to `.env` and fill in. Never commit the filled-in file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=

# API credentials from https://my.telegram.org → API development tools
API_ID=
API_HASH=

# Assistant userbot session (run: python session_generator.py)
# This account joins voice chats and actually streams the audio.
SESSION_STRING=

# ── Ownership & permissions ────────────────────────────────────────────────
# Your Telegram user ID. Gets every sudo command.
OWNER_ID=
# Extra sudo users, comma-separated.
SUDO_USERS=
# Group/channel that receives startup pings, gban logs and error reports.
LOG_GROUP_ID=

# ── Storage ────────────────────────────────────────────────────────────────
# Leave empty to use the bundled JSON store (data/*.json).
# Set a mongodb+srv://… URI for multi-instance / persistent deployments.
MONGO_URI=
MONGO_DB_NAME=musicbot

# ── Identity ───────────────────────────────────────────────────────────────
BOT_NAME=Ultimate Music
ASSISTANT_USERNAME=
# Shown as the 👑 Owner button on /start (username, no @)
OWNER_USERNAME=
# Shown as 💬 Support and 📢 Updates buttons. @handle or a full t.me link.
SUPPORT_CHAT=
SUPPORT_CHANNEL=
# Optional banner image shown above the /start card (direct image URL)
START_IMAGE_URL=
# Needed for the "Add me to your group" and share buttons (username, no @)
BOT_USERNAME=

# ── Music defaults ─────────────────────────────────────────────────────────
# studio | high | medium | low
AUDIO_QUALITY=high
# uhd_4k | qhd_2k | fhd_1080p | hd_720p | sd_480p | sd_360p
VIDEO_QUALITY=hd_720p
# audio | video
STREAM_MODE=audio
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=50
MAX_PLAYLIST_SIZE=100
# Longest playable track, in minutes (0 = unlimited)
DURATION_LIMIT=180
VIDEO_LIMIT=60
# Leave the voice chat after N seconds with nobody listening (0 = never)
AUTO_LEAVE_SECONDS=300
# Only admins may start playback
ADMINS_ONLY=false
# Non-admins must win a vote to skip. Fraction of listeners required.
VOTESKIP_RATIO=0.5
# Default UTC offset in minutes for /schedule (330 = IST). Per-chat /timezone wins.
DEFAULT_TZ_OFFSET_MIN=0

# ── Spotify (optional — enables spotify: links & playlist import) ───────────
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Behaviour ──────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
# Seconds a user must wait between commands (anti-spam; sudo is exempt)
THROTTLE_SECONDS=1.0
COMMAND_PREFIXES=/ !

# ── Web status page (health checks for Render/Koyeb/Railway) ───────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ── Downloads & artwork ────────────────────────────────────────────────────
ENABLE_DOWNLOADS=true
# Telegram caps bot uploads at 50 MB
MAX_DOWNLOAD_MB=48
AUDIO_BITRATE=320
# Private channel that stores uploaded audio so file_ids survive restarts.
# Add the bot as an admin, then put the -100… id here. Optional but recommended:
# it turns every repeat request for a track into a single instant API call.
STORAGE_CHAT_ID=

# ── Advanced ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Cookies file for age-restricted / rate-limited YouTube extraction
COOKIES_FILE=
