# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Userbot session string (run: python session_generator.py)
SESSION_STRING=your_session_string_here

# Optional: MongoDB for persistent queues (leave empty for in-memory)
MONGO_URI=

# Bot owner / sudo users (comma-separated user IDs)
SUDO_USERS=123456789

# Assistant username (without @) — the userbot account
ASSISTANT_USERNAME=your_assistant_username

# Max queue size per chat
MAX_QUEUE_SIZE=50

# Auto-leave VC after idle seconds (0 = disabled)
AUTO_LEAVE_IDLE=300

# Default volume (1-200)
DEFAULT_VOLUME=100
